# Cognito Configuration
COGNITO_DOMAIN=your-pool.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_REGION=us-east-1

# Proctor Access (comma-separated email addresses)
PROCTOR_EMAILS=admin@example.com,proctor@example.com

# Application Configuration
APP_URL=http://localhost:5000
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key-change-in-production

# AWS Configuration
BEDROCK_REGION=us-east-1
# Optional override - defaults to Claude Haiku 4.5 if unset
CLAUDE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
DYNAMODB_TABLE=AIAssuranceLab-UserMCPCredentials
DYNAMODB_CLASSES_TABLE=AIAssuranceLab-Classes
DYNAMODB_REGION=us-east-1

# ThousandEyes Admin (Administrative API v7) - optional. Only needed for the
# "Class Management" QR self-registration feature to auto-provision a
# dedicated ThousandEyes Account Group + user per student. This is an
# org-admin-level token, NOT a student's personal token - never share it,
# and keep .env at 600 perms. If unset, class scheduling/QR signup still
# works, it just skips ThousandEyes provisioning for those students.
THOUSANDEYES_ADMIN_TOKEN=your-thousandeyes-org-admin-api-token
# Built-in role granted to each auto-provisioned student, scoped to their
# own new Account Group only (never "Organization Admin" - that would grant
# org-wide access). Must match a role name in your ThousandEyes org exactly.
THOUSANDEYES_DEFAULT_ROLE_NAME=Account Admin

# Encryption Configuration
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-fernet-key-in-base64

# Galileo Observability (https://app.galileo.ai) - optional. If GALILEO_API_KEY
# is unset, all Galileo instrumentation is a no-op and chat works exactly as
# before; this is never required for the lab to function.
GALILEO_API_KEY=your-galileo-api-key
GALILEO_PROJECT=ai-assurance-lab
GALILEO_LOG_STREAM=production
