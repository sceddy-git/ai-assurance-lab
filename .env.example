# Cognito Configuration
COGNITO_DOMAIN=your-pool.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-client-id
COGNITO_CLIENT_SECRET=your-client-secret
COGNITO_USER_POOL_ID=us-east-1_xxxxx
COGNITO_REGION=us-east-1

# Proctor Access (comma-separated email addresses)
PROCTOR_EMAILS=admin@example.com,proctor@example.com

# Application Configuration
APP_URL=http://localhost:5000
FLASK_ENV=development
SECRET_KEY=your-flask-secret-key-change-in-production

# AWS Configuration
BEDROCK_REGION=us-east-1
# Optional override - defaults to Claude Haiku 4.5 if unset
CLAUDE_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
DYNAMODB_TABLE=AIAssuranceLab-UserMCPCredentials
DYNAMODB_CLASSES_TABLE=AIAssuranceLab-Classes
DYNAMODB_REGION=us-east-1

# NOTE on ThousandEyes auto-provisioning ("Class Management" QR
# self-registration): there is deliberately NO separate admin-token env
# var here. It reuses the super admin's own personal ThousandEyes token -
# the same one they save on their own Credentials page in the app - and is
# hard-locked in code (thousandeyes_admin.py, REQUIRED_ORG_NAME) to only
# ever touch the "AI-Powered Network Observability Day" ThousandEyes
# organization. If the super admin hasn't saved a token, or it belongs to
# a different org, auto-provisioning is simply skipped (Cognito login for
# students still works fine either way).

# Encryption Configuration
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-32-byte-fernet-key-in-base64

# Galileo Observability (https://app.galileo.ai) - optional. If GALILEO_API_KEY
# is unset, all Galileo instrumentation is a no-op and chat works exactly as
# before; this is never required for the lab to function.
GALILEO_API_KEY=your-galileo-api-key
GALILEO_PROJECT=ai-assurance-lab
GALILEO_LOG_STREAM=production

# Shared class-wide Meraki demo credential - optional. When set, every
# student automatically gets working Meraki access without pasting their
# own API key/Org ID on the Credentials page. A student's own saved
# credential (if they add one) always takes priority over this fallback.
# Never commit real values here - set them only in the server's actual
# .env file, which is gitignored.
MERAKI_SHARED_API_KEY=your-shared-meraki-api-key
MERAKI_SHARED_ORG_ID=your-shared-meraki-org-id
